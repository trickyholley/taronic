{
  "name": "taronic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal SVG card editor for drawing tarot deck art — icons in, SVG out.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons:lucide": "node scripts/build-icons.mjs node_modules/lucide-static/icons lucide src/icons/generated/lucide.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "lucide-static": "^0.462.0"
  }
}
